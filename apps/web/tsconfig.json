{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["node", "$app/types"],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"playwright.config.ts"
	]
}
