# ==========================================
# Triage Environment Configuration (.env.example)
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
METRICS_ADDR=:9090
SHUTDOWN_TIMEOUT=10s

# Security & Multi-tenancy
JWT_SECRET=super-secret-jwt-key-replace-with-at-least-32-chars-entropy
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Storage & Infrastructure (Postgres 16 + pgvector)
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage_secret_dev
POSTGRES_DB=triage
POSTGRES_PORT=5433
DATABASE_URL=postgres://triage:triage_secret_dev@localhost:5433/triage?sslmode=disable

# Redis 7 (Queues & Rate Limiting)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Worker concurrency
WORKER_CONCURRENCY=5

# LLM Providers (default: mock for offline deterministic execution)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Frontend
PUBLIC_API_URL=http://localhost:8080
PORT=3000

# Grafana
GRAFANA_PASSWORD=admin
